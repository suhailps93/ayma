#!/usr/bin/env bash

set -euo pipefail

backend_unit="ayma-backend.service"
tunnel_unit="ayma-tunnel.service"

usage() {
  cat <<'EOF'
Usage:
  ops/ayma-server install
  ops/ayma-server start
  ops/ayma-server stop
  ops/ayma-server restart
  ops/ayma-server status
  ops/ayma-server logs
  ops/ayma-server public-url
  ops/ayma-server tunnel-start
  ops/ayma-server tunnel-stop
  ops/ayma-server tunnel-restart
  ops/ayma-server tunnel-status
  ops/ayma-server tunnel-logs
EOF
}

require_systemd_user() {
  systemctl --user is-system-running >/dev/null 2>&1 || {
    echo "systemd user manager is not available" >&2
    exit 1
  }
}

install_units() {
  mkdir -p "$HOME/.config/systemd/user"
  cp "$(dirname "$0")/systemd/${backend_unit}" "$HOME/.config/systemd/user/${backend_unit}"
  cp "$(dirname "$0")/systemd/${tunnel_unit}" "$HOME/.config/systemd/user/${tunnel_unit}"
  systemctl --user daemon-reload
  echo "Installed user units into ~/.config/systemd/user"
}

unit_logs() {
  local unit="$1"
  journalctl --user -u "$unit" -n 200 -f
}

print_public_url() {
  journalctl --user -u "$tunnel_unit" --no-pager |
    grep -Eo 'https://[a-zA-Z0-9.-]+trycloudflare.com' |
    tail -n 1
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  require_systemd_user

  case "$1" in
    install)
      install_units
      ;;
    start)
      systemctl --user enable --now "$backend_unit"
      ;;
    stop)
      systemctl --user stop "$backend_unit"
      ;;
    restart)
      systemctl --user restart "$backend_unit"
      ;;
    status)
      systemctl --user status "$backend_unit" --no-pager
      ;;
    logs)
      unit_logs "$backend_unit"
      ;;
    public-url)
      print_public_url
      ;;
    tunnel-start)
      systemctl --user enable --now "$tunnel_unit"
      ;;
    tunnel-stop)
      systemctl --user stop "$tunnel_unit"
      ;;
    tunnel-restart)
      systemctl --user restart "$tunnel_unit"
      ;;
    tunnel-status)
      systemctl --user status "$tunnel_unit" --no-pager
      ;;
    tunnel-logs)
      unit_logs "$tunnel_unit"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
