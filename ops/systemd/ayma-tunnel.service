[Unit]
Description=Ayma public tunnel
After=network-online.target ayma-backend.service
Wants=network-online.target
Requires=ayma-backend.service

[Service]
Type=simple
WorkingDirectory=%h/latest_claude/ayma
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/latest_claude/ayma/ops/run_public_tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
