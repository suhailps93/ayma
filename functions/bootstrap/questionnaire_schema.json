{
  "version": "1.1.0",
  "owner": "ayma",
  "objective": "Maximize profile completeness by collecting high-signal relationship data with explicit consent and safe handling of sensitive attributes.",
  "sync_contract": {
    "source": "functions/bootstrap/questionnaire_graph.py",
    "rule": "Schema is loaded via load_profile_schema() in questionnaire_graph.py. Matching field routing uses GLOBAL_FIELDS and INTENT_SPECIFIC_FIELDS in the same module."
  },
  "scoring_model": {
    "profile_completeness_weights": {
      "core_matchability": 40,
      "intent_and_readiness": 20,
      "lifestyle_compatibility": 15,
      "values_and_family_alignment": 15,
      "depth_and_authenticity": 10
    },
    "answer_score_rules": {
      "required_answered": 1,
      "optional_answered": 0.6,
      "skipped": 0,
      "prefer_not_to_say": 0.2
    }
  },
